# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_product_studio

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# LLM Provider Configuration
# Options: openai, claude, ollama, mock (default: mock)
LLM_PROVIDER=mock

# Global LLM Settings (applies to all agents unless overridden)
LLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# OpenAI Configuration
OPENAI_API_KEY=

# Anthropic (Claude) Configuration
ANTHROPIC_API_KEY=

# Ollama Configuration (for local models)
OLLAMA_API_BASE=http://localhost:11434

# Agent-Specific LLM Configuration (optional)
# Override LLM provider for specific agents
# ARCHITECT_LLM_PROVIDER=claude
# ARCHITECT_LLM_MODEL=claude-3-sonnet-20240229
# IMPLEMENTER_LLM_PROVIDER=openai
# IMPLEMENTER_LLM_MODEL=gpt-4-turbo-preview
# REVIEWER_LLM_PROVIDER=ollama
# REVIEWER_LLM_MODEL=llama2

# Debug
SQL_ECHO=false
